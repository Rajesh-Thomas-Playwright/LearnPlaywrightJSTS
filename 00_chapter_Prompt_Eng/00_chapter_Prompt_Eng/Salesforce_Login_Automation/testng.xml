<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Salesforce Login Suite">
    <test name="Chrome Login Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.qa.salesforce.tests.UnknownUsernameLoginTest"/>
            <class name="com.qa.salesforce.tests.EmptyAndBoundaryInputTest"/>
            <class name="com.qa.salesforce.tests.ForgotPasswordLinkTest"/>
            <class name="com.qa.salesforce.tests.LocaleParameterTest"/>
            <class name="com.qa.salesforce.tests.SqlLikeInputTest"/>
        </classes>
    </test>
    <test name="Firefox Login Tests">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.qa.salesforce.tests.UnknownUsernameLoginTest"/>
            <class name="com.qa.salesforce.tests.EmptyAndBoundaryInputTest"/>
            <class name="com.qa.salesforce.tests.ForgotPasswordLinkTest"/>
            <class name="com.qa.salesforce.tests.LocaleParameterTest"/>
            <class name="com.qa.salesforce.tests.SqlLikeInputTest"/>
        </classes>
    </test>
</suite>
